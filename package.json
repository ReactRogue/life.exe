{
  "name": "life-exe",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:web": "expo export --platform web",
    "release:info": "node scripts/app-info.mjs",
    "release:bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/chakra-petch": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "clsx": "^2.1.1",
    "expo": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "^58.0.4",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "^0.13.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.19",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "expo": {
    "install": {
      "exclude": [
        "nativewind"
