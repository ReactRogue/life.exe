{
  "expo": {
    "name": "Life.exe",
    "slug": "life-exe",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lifeexe",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060A12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.lifeexe.os",
      "buildNumber": "1"
    },
    "android": {
      "package": "app.lifeexe.os",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060A12"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Life.exe — Personal OS",
      "shortName": "Life.exe",
      "themeColor": "#060A12",
      "backgroundColor": "#060A12"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#060A12"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
